// Volumetric sunlight ("god rays") computed by ray marching through the
// shadow map. Ported from Quake 2 RTX (god_rays.comp), GPL v2.
// Runs at full render resolution for v1 (Q2RTX uses half-res + bilateral filter).

#version 460
#extension GL_EXT_samplerless_texture_functions : enable

#define DESC_SET_GOD_RAYS_SHADOW 0
#define DESC_SET_GOD_RAYS_PARAMS 1
#define DESC_SET_FRAMEBUFFERS 2
#define DESC_SET_GLOBAL_UNIFORM 3
#define DESC_SET_RANDOM 4
#include "ShaderCommonGLSLFunc.h"
#include "Random.h"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = DESC_SET_GOD_RAYS_SHADOW, binding = 0) uniform sampler2D texShadowMap;

layout(set = DESC_SET_GOD_RAYS_PARAMS, binding = 0) readonly buffer GodRaysParams_BT
{
    vec4 sunDirection;
    vec4 sunColor;
    vec4 worldCenter;
    vec4 worldHalfSizeInv;
    mat4 shadowMapVP;
    float shadowMapDepthScale;
    float godRaysIntensity;
    float godRaysEccentricity;
    uint godRaysEnabled;
    float _padding;
} godRaysParams;

float GetShadow(vec3 worldPos)
{
    vec4 uvz = godRaysParams.shadowMapVP * vec4(worldPos, 1);
    uvz.x = uvz.x * 0.5 + 0.5;
    uvz.y = 0.5 - 0.5 * uvz.y;

    float depthOpaque = textureLod(texShadowMap, uvz.xy, 0).x;
    return depthOpaque > uvz.z ? 1.0 : 0.0;
}

const float PI = 3.1415926535;

float ScatterPhase_HenyeyGreenstein(float cosa, float g)
{
    // "normalized" Henyey-Greenstein
    const float g_sqr = g * g;
    const float num = (1.0 - abs(g));
    const float denom = sqrt(max(1.0 - 2.0 * g * cosa + g_sqr, 0.0));
    const float frac = num / denom;
    const float scale = g_sqr + (1.0 - g_sqr) / (4.0 * PI);
    return scale * (frac * frac * frac);
}

float vmin(vec3 v) { return min(v.x, min(v.y, v.z)); }
float vmax(vec3 v) { return max(v.x, max(v.y, v.z)); }

bool IntersectRayBox(vec3 origin, vec3 direction, vec3 mins, vec3 maxs, out float tIn, out float tOut)
{
    vec3 t1 = (mins - origin) / direction;
    vec3 t2 = (maxs - origin) / direction;
    tIn = vmax(min(t1, t2));
    tOut = vmin(max(t1, t2));
    return tIn < tOut && tOut > 0;
}

float getDensity(vec3 p)
{
    // 1.0 inside the world box, falls off to 0 over 25% of world size outside
    vec3 bounds = clamp(3.0 - 2.0 * abs((p - godRaysParams.worldCenter.xyz) * godRaysParams.worldHalfSizeInv.xyz), vec3(0), vec3(1));
    return bounds.x * bounds.y * bounds.z;
}

float getStep(float t, float density)
{
    return max(1.0, mix(20.0, 5.0, density));
}

void main()
{
    const ivec2 pixelPos = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 screenSize = ivec2(globalUniform.renderWidth, globalUniform.renderHeight);
    if (any(greaterThanEqual(pixelPos, screenSize)))
        return;

    if (godRaysParams.godRaysEnabled == 0)
    {
        imageStore(framebufGodRays, pixelPos, vec4(0));
        return;
    }

    if (getLuminance(godRaysParams.sunColor.rgb) == 0.0)
    {
        imageStore(framebufGodRays, pixelPos, vec4(0));
        return;
    }

    // surface data for this pixel (checkerboard storage)
    const ivec2 cbPix = getCheckerboardPix(pixelPos);

    const vec3 surfacePos = texelFetch(framebufSurfacePosition_Sampler, cbPix, 0).xyz;
    const vec3 direction  = texelFetch(framebufViewDirection_Sampler, cbPix, 0).xyz;
    const vec3 throughput = texelFetch(framebufThroughput_Sampler, cbPix, 0).xyz;
    float rayDistance = texelFetch(framebufDepthWorld_Sampler, cbPix, 0).x;

    // sky pixels have no surface — no volumetric sunlight
    if (rayDistance > MAX_RAY_LENGTH)
    {
        imageStore(framebufGodRays, pixelPos, vec4(0));
        return;
    }

    // start marching from where the ray enters the world box
    const vec3 originalPos = surfacePos - direction * rayDistance;

    const float cosa = dot(direction, godRaysParams.sunDirection.xyz);
    const float phase = ScatterPhase_HenyeyGreenstein(cosa, godRaysParams.godRaysEccentricity);

    float offset = 0.0;
    float tIn, tOut;
    const vec3 halfSize = 1.0 / godRaysParams.worldHalfSizeInv.xyz;
    const vec3 boxMins = godRaysParams.worldCenter.xyz - halfSize * 0.75; // matches getDensity bounds
    const vec3 boxMaxs = godRaysParams.worldCenter.xyz + halfSize * 0.75;

    if (IntersectRayBox(originalPos, direction, boxMins, boxMaxs, tIn, tOut))
    {
        if (tIn > rayDistance)
        {
            imageStore(framebufGodRays, pixelPos, vec4(0));
            return;
        }

        offset = max(tIn, offset);
        rayDistance = min(tOut, rayDistance);
    }
    else
    {
        imageStore(framebufGodRays, pixelPos, vec4(0));
        return;
    }

    vec3 currentPos = originalPos + direction * offset;
    float density = getDensity(currentPos);

    vec3 through = throughput;
    vec3 inscatter = vec3(0);

    // randomize the first step to break banding
    const uint seed = getRandomSeed(pixelPos, globalUniform.frameId);
    const float rnd = rndBlueNoise8(seed, 0).x;
    offset += getStep(offset, density) * (rnd - 1.0);

    while (true)
    {
        density = getDensity(currentPos);
        const float stepLength = getStep(offset, density);

        offset += stepLength;
        if (offset >= rayDistance)
            break;

        currentPos = originalPos + direction * offset;

        const vec3 shadowBias = -godRaysParams.sunDirection.xyz * 20.0;
        const float shadow = GetShadow(currentPos + shadowBias);

        const vec3 differentialInscatter = (shadow * phase * stepLength * density) * through;
        inscatter += differentialInscatter;
        through *= exp(-(stepLength * density) * vec3(0.0001));
    }

    const vec3 inscatterColor = inscatter * godRaysParams.sunColor.rgb * godRaysParams.godRaysIntensity * 0.0001;

    imageStore(framebufGodRays, pixelPos, vec4(inscatterColor, 0));
}
